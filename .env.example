# Copy to .env and fill in. Never commit .env.

# Meta Model API key (format: LLM|{numeric_id}|{secret}). Required for live runs.
MODEL_API_KEY=

# Optional (S-3): Muse Spark Open via Baseten for the Designer. With a key and
# FRAMELAB_DESIGNER_BACKEND=auto, the Designer uses it (Muse Spark 1.3 as fallback).
BASETEN_API_KEY=

# FrameLab settings (defaults shown)
FRAMELAB_RUNS_DIR=runs
FRAMELAB_DEMO=0
FRAMELAB_DEMO_ALLOW_UPLOAD=0
FRAMELAB_MAX_UPLOAD_MB=200
FRAMELAB_MAX_ANALYSIS_S=20
FRAMELAB_CONCURRENCY=2
FRAMELAB_USE_WONDER=0
FRAMELAB_MASK_DILATION_PX=1.5
FRAMELAB_DESIGNER_BACKEND=auto
FRAMELAB_DAILY_BUDGET_USD=10

# Public deployment (M11): samples, replays and credit protection
FRAMELAB_DEMO_DIR=demo_runs
FRAMELAB_UPLOAD_LIMIT_PER_HOUR=10
FRAMELAB_REPLAY_LIMIT_PER_HOUR=30
FRAMELAB_REPLAY_TTL_HOURS=6
# Proxies in front of the app that append to X-Forwarded-For (1 on Railway/Render; the image sets 1)
FRAMELAB_FORWARDED_HOPS=0
FRAMELAB_LOG_LEVEL=INFO

# Testing
FRAMELAB_LIVE_TESTS=0
# When set, live clients save every API response here (for golden fixtures)
FRAMELAB_RECORD_DIR=
