# Copy to .env and fill in. Never commit .env.

# Meta Model API key (format: LLM|{numeric_id}|{secret}). Required for live runs.
MODEL_API_KEY=

# Optional: only for stretch goal S-3 (Muse Spark Open via Baseten)
BASETEN_API_KEY=

# FrameLab settings (defaults shown)
FRAMELAB_RUNS_DIR=runs
FRAMELAB_DEMO=0
FRAMELAB_DEMO_ALLOW_UPLOAD=0
FRAMELAB_MAX_UPLOAD_MB=200
FRAMELAB_MAX_ANALYSIS_S=20
FRAMELAB_CONCURRENCY=2
FRAMELAB_USE_WONDER=1
FRAMELAB_DESIGNER_BACKEND=meta
FRAMELAB_DAILY_BUDGET_USD=10
FRAMELAB_LOG_LEVEL=INFO

# Testing
FRAMELAB_LIVE_TESTS=0
# When set, live clients save every API response here (for golden fixtures)
FRAMELAB_RECORD_DIR=
