<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  @page { size: A4; margin: 16mm 16mm 18mm 16mm; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 10.5pt; line-height: 1.45; color: #1f2933; background: #ffffff;
  }
  header { border-bottom: 2px solid #0b7a99; padding-bottom: 8px; margin-bottom: 14px; }
  h1 { font-size: 18pt; margin: 0 0 4px 0; color: #111827; }
  .meta { font-size: 9pt; color: #5b6573; }
  .badge {
    display: inline-block; padding: 2px 10px; border-radius: 3px; font-weight: 600;
    font-size: 9pt; letter-spacing: 0.04em; color: #ffffff; background: #5b6573;
  }
  .badge.PASS, .badge.PASS_WITH_WARNINGS { background: #1e7b4a; }
  .badge.NEEDS_RERECORD, .badge.REJECT { background: #b42318; }
  .headline {
    font-size: 15pt; font-weight: 600; color: #0b7a99; margin: 6px 0 2px 0;
  }
  section { margin-top: 12px; page-break-inside: auto; }
  h2 {
    font-size: 11.5pt; margin: 0 0 6px 0; padding-bottom: 3px;
    border-bottom: 1px solid #d5dbe3; color: #111827;
  }
  p { margin: 0 0 6px 0; text-align: left; }
  figure { margin: 8px 0; page-break-inside: avoid; }
  figure img { width: 100%; height: auto; border: 1px solid #e5e7eb; }
  figcaption { font-size: 8.5pt; color: #5b6573; margin-top: 3px; }
  .two { display: flex; gap: 12px; }
  .two > div { flex: 1; }
  .keyframe img { max-width: 100%; height: auto; border: 1px solid #e5e7eb; }
  table { width: 100%; border-collapse: collapse; font-size: 9pt; margin: 4px 0 6px 0; }
  th, td { border: 1px solid #d5dbe3; padding: 3px 5px; vertical-align: top; text-align: left; }
  th { background: #f3f5f8; font-weight: 600; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  tr { page-break-inside: avoid; }
  .hard { color: #b42318; font-weight: 600; }
  .soft { color: #5b6573; }
  ul { margin: 2px 0 6px 18px; padding: 0; }
  li { margin-bottom: 2px; }
  .appendix { page-break-before: always; }
  .small { font-size: 8.5pt; color: #5b6573; }
  footer { margin-top: 16px; font-size: 8pt; color: #7b8593; border-top: 1px solid #e5e7eb;
           padding-top: 4px; }
</style>
</head>
<body>

<header>
  <h1>{{ title }}</h1>
  <div class="meta">
    {{ t.run }} {{ run_id }} · {{ t.date }} {{ date }} ·
    {{ t.verdict }}: <span class="badge {{ verdict }}">{{ verdict_label }}</span>
  </div>
  {% if headline %}<div class="headline">{{ headline }}</div>{% endif %}
</header>

<section>
  <h2>{{ t.aim }}</h2>
  <p>{{ aim }}</p>
</section>

<section>
  <h2>{{ t.setup }}</h2>
  <p>{{ setup }}</p>
  {% if keyframe %}
  <figure class="keyframe">
    <img src="{{ keyframe }}" alt="{{ t.keyframe }}">
    <figcaption>{{ t.keyframe }}</figcaption>
  </figure>
  {% endif %}
</section>

<section>
  <h2>{{ t.method }}</h2>
  <p>{{ method }}</p>
  <table>
    <thead><tr><th>{{ t.models }}</th><th>{{ t.role }}</th></tr></thead>
    <tbody>
    {% for m in models %}<tr><td>{{ m.role }}</td><td>{{ m.use }}</td></tr>{% endfor %}
    </tbody>
  </table>
</section>

<section>
  <h2>{{ t.results }}</h2>
  {% if figure %}
  <figure>
    <img src="{{ figure }}" alt="{{ t.figure }}">
    <figcaption>{{ t.figure }}</figcaption>
  </figure>
  {% endif %}
  {% for r in results %}
    <h3 style="font-size:10.5pt;margin:8px 0 2px 0;">{{ r.heading }}</h3>
    <p>{{ r.body }}</p>
  {% endfor %}
</section>

{% if hypothesis %}
<section>
  <h2>{{ t.hypothesis }}</h2>
  <p>{{ hypothesis }}</p>
</section>
{% endif %}

<section>
  <h2>{{ t.errors }}</h2>
  <p>{{ errors }}</p>
</section>

<section>
  <h2>{{ t.conclusion }}</h2>
  <p>{{ conclusion }}</p>
</section>

{% if next %}
<section>
  <h2>{{ t.next }}</h2>
  <p><strong>{{ next.title }}</strong></p>
  <p>{{ next.prediction }}</p>
  {% if next.predictions %}
  <ul>{% for p in next.predictions %}<li>{{ p }}</li>{% endfor %}</ul>
  {% endif %}
  <p class="small">{{ t.controlled }}: {{ next.controlled | join(", ") }}</p>
  <ol>{% for s in next.steps %}<li>{{ s }}</li>{% endfor %}</ol>
  {% if next.safety %}<p class="small">{{ t.safety }}: {{ next.safety | join(" · ") }}</p>{% endif %}
</section>
{% endif %}

<div class="appendix"></div>
<section>
  <h2>{{ t.appendix_a }}</h2>
  <table>
    <thead><tr><th>#</th><th>{{ t.claim }}</th><th>{{ t.evidence }}</th></tr></thead>
    <tbody>
    {% for c in claims %}
      <tr><td>{{ c.id }}</td><td>{{ c.text }}</td><td>{{ c.evidence }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
</section>

<section>
  <h2>{{ t.appendix_b }}</h2>
  <table>
    <thead>
      <tr><th>{{ t.gate }}</th><th>{{ t.status }}</th><th>{{ t.diagnosis }}</th>
          <th>{{ t.message }}</th></tr>
    </thead>
    <tbody>
    {% for g in gates %}
      <tr>
        <td>{{ g.gate }} {{ g.name }}<br><span class="small">{{ g.hard }}</span></td>
        <td class="{{ 'hard' if g.status == 'fail' else 'soft' }}">{{ g.status }}</td>
        <td>{{ g.diagnosis }}</td>
        <td>{{ g.message }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</section>

<section>
  <h2>{{ t.appendix_c }}</h2>
  <table>
    <thead>
      <tr><th class="num">{{ t.time }}</th><th class="num">{{ t.x }}</th>
          <th class="num">{{ t.y }}</th><th>{{ t.valid }}</th><th>{{ t.flag }}</th></tr>
    </thead>
    <tbody>
    {% for r in sample %}
      <tr><td class="num">{{ r.t }}</td><td class="num">{{ r.x }}</td><td class="num">{{ r.y }}</td>
          <td>{{ r.valid }}</td><td>{{ r.flag }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
</section>

<footer>
  {{ t.page_note }} {{ built }}{% if auditor_model %} · Auditor: {{ auditor_model }}{% endif %}
</footer>

</body>
</html>
