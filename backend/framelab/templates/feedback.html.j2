<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Recording feedback / Umpan balik rekaman</title>
<style>
  @page { size: A4; margin: 14mm 14mm 14mm 14mm; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif; font-size: 9.5pt;
         line-height: 1.4; color: #1f2933; }
  h1 { font-size: 15pt; margin: 0 0 2px 0; }
  .meta { font-size: 8.5pt; color: #5b6573; margin-bottom: 8px; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 3px; font-weight: 600;
           font-size: 9pt; color: #fff; background: #b42318; }
  .cols { display: flex; gap: 12px; }
  .cols > div { flex: 1; }
  h2 { font-size: 10.5pt; margin: 10px 0 4px 0; padding-bottom: 2px;
       border-bottom: 1px solid #d5dbe3; }
  ul { margin: 2px 0 4px 16px; padding: 0; }
  li { margin-bottom: 3px; }
  .key { width: 100%; border: 1px solid #e5e7eb; }
  .small { font-size: 8pt; color: #5b6573; }
</style>
</head>
<body>

<h1>{{ t_en.feedback }} · {{ t_id.feedback }}</h1>
<div class="meta">
  {{ t_en.run }} {{ run_id }} · {{ date }} ·
  <span class="badge">{{ verdict_label.en }} / {{ verdict_label.id }}</span>
</div>

<div class="cols">
  <div>
    <h2>{{ t_en.failed }}</h2>
    <ul>{% for f in failed %}<li><strong>{{ f.gate }}</strong> {{ f.en }}</li>{% endfor %}</ul>
    <h2>{{ t_en.tips }}</h2>
    <ul>{% for tip in tips_en %}<li>{{ tip }}</li>{% endfor %}</ul>
  </div>
  <div>
    <h2>{{ t_id.failed }}</h2>
    <ul>{% for f in failed %}<li><strong>{{ f.gate }}</strong> {{ f.id }}</li>{% endfor %}</ul>
    <h2>{{ t_id.tips }}</h2>
    <ul>{% for tip in tips_id %}<li>{{ tip }}</li>{% endfor %}</ul>
  </div>
</div>

{% if keyframe %}
<h2>{{ t_en.keyframe }} · {{ t_id.keyframe }}</h2>
<img class="key" src="{{ keyframe }}" alt="{{ t_en.keyframe }}">
<p class="small">Amber: reference outline · Cyan: tracked object outline.
  Kuning: garis referensi · Biru: garis objek yang dilacak.</p>
{% endif %}

<p class="small">{{ t_en.page_note }}</p>

</body>
</html>
